#Now ofcourse you will have to extract the rootfs.gz:
#extra rootfs's ( the file thats inside rootfs.gz ) content to the respective partition that is to be the root of the other system, in my case tiny core:
#add this to /etc/grub.d/40_custom:
#!/bin/sh
exec tail -n +3 $0
# This file provides an easy way to add custom menu entries.  Simply type the
# menu entries you want to add after this comment.  Be careful not to change
# the 'exec tail' line above.
menuentry 'tiny-core linux' --class linux --class gnu-linux --class gnu --class os $menuentry_id_option 'linux-tinycore-808536ca-a857-444e-84c4-309ba5b6b525' {
                load_video
                insmod chain
                insmod part_gpt
                insmod fat
                search --no-floppy --fs-uuid --set=root 7065-BAB0
                echo    'Loading UKI tinycore.efi ...'
                chainloader     /EFI/Non-Gentoo-kernels-images/tinycore.efi root=UUID=b1ad027f-e3fc-4937-85ea-1a34a0b61a92 ro quiet resume=PARTUUID='89d25cfd-8f81-42d7-a80b-439323a04033'

        }
#--set=root 7065-BAB0 defines the efi partition
#root=UUID=uuid specifies the exact root partition that will be used as root
#the command for slitaz is almost exactly similar except for the partition names and menuid(according to AI the numeric value is uuid4 hence I also used uuid4 for the sake of following the >
menuentry 'slitaz linux' --class linux --class gnu-linux --class gnu --class os $menuentry_id_option 'linux-slitaz-af379d11-1bb3-4914-84fd-ddbe92ca0962' {
                load_video
                insmod chain
                insmod part_gpt
                insmod fat
                search --no-floppy --fs-uuid --set=root 7065-BAB0
                echo    'Loading UKI slitaz.efi ...'
                chainloader     /EFI/Non-Gentoo-kernels-images/slitaz.efi  root=UUID=d077fd65-c05a-48f4-9f35-ed34f140dede ro quiet resume=PARTUUID='89d25cfd-8f81-42d7-a80b-439323a04033'

        }




#then run:
sudo grub-install --efi-directory=/efi
grub-mkconfig -o /boot/grub/grub.cfg



